WITH RECURSIVE project_paths AS (
  -- 1. Base Case: Select top-level projects (Root)
  SELECT 
    id, 
    name, 
    parent_project_id, 
    CAST(name AS TEXT) as full_path
  FROM projects
  WHERE parent_project_id IS NULL

  UNION ALL

  -- 2. Recursive Step: Join children to parents
  SELECT 
    child.id, 
    child.name, 
    child.parent_project_id, 
    CAST(parent.full_path || '/' || child.name AS TEXT)
  FROM projects child
  JOIN project_paths parent ON child.parent_project_id = parent.id
)

SELECT 
  -- 1. Data Source Name
  ds.name AS "Data Source Name",

  -- 2. Data Source Path
  COALESCE(ds_path.full_path, 'Root/Orphaned') AS "Data Source Path",

  -- 3. Data Source DB Name 
  -- (We get this from the connection INSIDE the published datasource)
  COALESCE(origin_dc.dbname, 'File/Unknown') AS "Data Source DB Name",

  -- 4. Workbook Name
  -- (Can be NULL if the data source is not used by any workbook)
  w.name AS "Workbook Name",

  -- 5. Workbook Path
  COALESCE(wb_path.full_path, 'Not Used/NA') AS "Workbook Path"

FROM datasources ds

-- Filter for specific Site ID immediately
WHERE ds.site_id = 4

-- A. Get the Project Path for the Data Source
LEFT JOIN project_paths ds_path 
  ON ds.project_id = ds_path.id

-- B. Get the "Origin" Connection 
-- This finds the actual DB details (e.g., Snowflake/SQL Server) of the Published Source
LEFT JOIN data_connections origin_dc 
  ON ds.id = origin_dc.owner_id 
  AND origin_dc.owner_type = 'Datasource'

-- C. Find Workbooks that use this Data Source ("Downstream" dependencies)
LEFT JOIN data_connections usage_dc 
  ON ds.id = usage_dc.datasource_id 

-- D. Get the Workbook details
LEFT JOIN workbooks w 
  ON usage_dc.owner_id = w.id 
  AND usage_dc.owner_type = 'Workbook'

-- E. Get the Project Path for the Workbook
LEFT JOIN project_paths wb_path 
  ON w.project_id = wb_path.id;
